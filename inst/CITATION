if(!exists("meta") || is.null(meta)) meta <- packageDescription("FishSET")


citHeader("To cite the 'FishSET' package in publications use:")

year <- sub(".*(2[[:digit:]]{3})-.*", "\\1", meta$Date, perl = TRUE)
vers <- paste("R package version", meta$Version)

citEntry(entry="Manual",
         title = "FishSET: Spatial Economics Toolbox for Fisheries",
         author = personList(as.person("Lisa Pfeiffer"),
                             as.person("Paul Carvalho"),
                             as.person("Anna Abelman"),
                             as.person("Alan Haynie")),
         year = year,
         note = vers,
         url = "",
         textVersion =
           paste("Lisa Pfeiffer, Paul Carvalho, Anna Abelman, and Alan Haynie (", year,
                 "). FishSET: Spatial Economics Toolbox for Fisheries. ",
                 vers, ".", " DOI: 10.5281/zenodo.21796076", sep="") )

citEntry(entry="Manual",
         title = paste0("Introduction to FishSET", meta$Version),
         author = personList(as.person("Lisa Pfeiffer"),
                             as.person("Paul Carvalho"),
                             as.person("Anna Abelman"),
                             as.person("Alan Haynie")),
         year = year,
         note = vers,
         url = "",
         textVersion =
           paste0("Pfeiffer, L., Carvalho, P., Abelman, A., and A. Haynie (", year, ") Introduction to FishSET v", meta$Version, " DOI: 10.5281/zenodo.21796076" ) )
